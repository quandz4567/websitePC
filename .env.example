# Local demo credentials only. For Compose, use a URL-safe password (letters,
# numbers, underscore, hyphen). It is inserted directly into DATABASE_URL.
# For a separately configured host DATABASE_URL, URL-encode special characters.
# Compose reads root .env; host npm API commands read apps/api/.env.
# Compose fixes PORT=3001 and CORS_ORIGIN=http://localhost:8080 internally;
# DATABASE_URL, PORT and CORS_ORIGIN below configure host npm commands only.
POSTGRES_PASSWORD=pcstore_local
DATABASE_URL=postgres://pcstore:pcstore_local@localhost:5432/pcstore
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Set explicitly only for the ephemeral demo without PostgreSQL:
# DEMO_DB=memory
